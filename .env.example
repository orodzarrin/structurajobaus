# Canonical host used for canonical tags, sitemap, robots and Open Graph.
# Points at the live Vercel deployment until a custom domain is attached.
NEXT_PUBLIC_SITE_URL=https://structuraljobaus.vercel.app

# --- Job ingestion (scripts/ingest-jobs.mjs) ------------------------------
# Every source is optional. The nightly refresh skips whichever keys are empty.
# Add the same names as GitHub Actions secrets so the 6am run can use them.

# Careerjet publisher key — free, no card. https://www.careerjet.com/partners/api
CAREERJET_API_KEY=

# Jooble key — free, 500 requests for the lifetime of the key.
# Australian jobs need a key created on https://au.jooble.org/api/about
JOOBLE_API_KEY=

# Adzuna — trial (25 calls) or paid (£8/month). https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Token used by /api/job-submissions to file employer submissions as GitHub
# issues (the review queue). Fine-grained PAT with Issues: write on this repo.
# Without it, the endpoint returns 503 and the form shows a setup message.
GITHUB_TOKEN=
GITHUB_REPO=farshadbh/structurajobaus

# Set to 1 to render the bundled demo listings before the first real sync.
# Never enable this in production.
NEXT_PUBLIC_DEMO_JOBS=0

# --- Accounts, saved lists and email alerts --------------------------------
# All three are required for sign-in to work. Without them the account pages
# show a setup notice and every other page on the board is unaffected.

# Upstash Redis, REST API (free tier: 256 MB, 10k commands/day).
# https://console.upstash.com -> create a Redis database -> REST API section.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Signs the session cookie (HMAC-SHA256). Any long random string, e.g.
#   openssl rand -hex 32
# Changing it signs everybody out.
AUTH_SECRET=

# Google sign-in (Continue with Google in the profile menu).
# Create an OAuth 2.0 client in Google Cloud (APIs & Services -> Credentials)
# and register this exact authorized redirect URI:
#   https://structurajobaus-two.vercel.app/api/auth/google/callback
# (On localhost it is http://localhost:3000/api/auth/google/callback.)
# Without these, the button sends people to /login with an explanation.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Digest sending (scripts/send-digests.mjs, GitHub Actions only) --------
# Brevo free plan: 300 emails/day. Verify the sender address in Brevo first.
BREVO_API_KEY=
# e.g. "SE Jobs Australia <you@example.com>" — the address must be verified.
EMAIL_FROM=
# Public URL used in email links (job pages, /account, unsubscribe).
SITE_URL=https://structuraljobaus.vercel.app
